# Copy to .env.local and fill in what you have.
# EVERY integration is optional: anything left blank falls back to a local
# implementation, so `uvicorn app.main:app` works with this file untouched.

ENVIRONMENT=development          # set to "production" for real deployments
BASE_URL=http://localhost:8000   # public URL, used in emails and download links
LOCAL_DATA_DIR=./data            # SQLite DB, PDFs, uploads, email outbox (local mode)

# ── Auth (REQUIRED in production: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72
OTP_EXPIRE_MINUTES=10

# ── LLM — pick one (blank = rule-based offline analysis)
# Option A: Azure OpenAI
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_LARGE=gpt-4o-legal
AZURE_OPENAI_DEPLOYMENT_SMALL=gpt-4o-mini-fast
# Option B: OpenAI or any OpenAI-compatible server (set OPENAI_BASE_URL for local models)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_LARGE=gpt-4o
OPENAI_MODEL_SMALL=gpt-4o-mini

# ── Database (blank = SQLite at LOCAL_DATA_DIR/legalai.db)
COSMOS_CONNECTION_STRING=
COSMOS_DATABASE_NAME=legalai-db

# ── File storage (blank = local disk with signed, expiring download links)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=

# ── Email (blank = saved to LOCAL_DATA_DIR/outbox, viewable at /api/dev/outbox;
#    login codes are shown in the UI. Required in production.)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ── Content safety (blank = local abuse-pattern rules only)
CONTENT_SAFETY_KEY=
CONTENT_SAFETY_ENDPOINT=

# ── Monitoring (optional)
APPINSIGHTS_INSTRUMENTATION_KEY=
RATE_LIMIT_ENABLED=true
